[Unit]
Description=frame-tv-sync Chromium kiosk (cage)
After=frame-serve.service systemd-user-sessions.target
Wants=frame-serve.service
ConditionPathExists=/dev/tty1

[Service]
User=frame
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
PermissionsStartOnly=true
ExecStartPre=/usr/bin/chvt 1
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/opt/frame-tv-sync/bin/start-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
